{
  "manifest_version": 3,
  "name": "Hameau · concentration",
  "version": "1.2.0",
  "description": "Pendant un chrono Hameau : te demande « tu es sûr ? » avant de changer de page, bloque les sites ou les adresses que tu choisis (YouTube, LinkedIn, Instagram…), et retient les sites sur lesquels tu travailles pour que Hameau te les montre. Tout se relâche à l'arrêt du chrono.",
  "minimum_chrome_version": "120",
  "permissions": [
    "declarativeNetRequest",
    "storage",
    "alarms",
    "tabs",
    "webNavigation",
    "idle"
  ],
  "host_permissions": [
    "https://nisjysdlyryyrsgwmcaa.supabase.co/*",
    "*://*.youtube.com/*",
    "*://*.linkedin.com/*",
    "*://*.instagram.com/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Hameau",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icones/icone-16.png",
      "48": "icones/icone-48.png",
      "128": "icones/icone-128.png"
    }
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "content_scripts": [
    {
      "matches": [
        "https://maeljoly68-art.github.io/hameau/*"
      ],
      "js": [
        "relais.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icones/icone-16.png",
    "48": "icones/icone-48.png",
    "128": "icones/icone-128.png"
  },
  "optional_host_permissions": [
    "*://*/*"
  ]
}
